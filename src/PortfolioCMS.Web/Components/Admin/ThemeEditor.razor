@namespace PortfolioCMS.Web.Components.Admin

<div class="editor-panel theme-editor">
    <h2>Theme Settings</h2>
    <p class="editor-hint">Changes apply live — refresh the public page to see them.</p>

    @if (_edit is not null)
    {
        <!-- Live preview bar -->
        <div class="theme-preview"
             style="background:@_edit.BackgroundColor; color:@_edit.TextColor;
                    border-color:@_edit.PrimaryColor">
            <span style="font-family:@_edit.FontFamily,sans-serif">
                <strong style="color:@_edit.PrimaryColor">@_edit.PrimaryColor</strong>
                &nbsp; Preview Text &nbsp;
                <em style="color:@_edit.AccentColor">Accent</em>
            </span>
        </div>

        <div class="color-grid">
            <div class="form-group">
                <label>Primary Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.PrimaryColor" />
                    <input @bind="_edit.PrimaryColor" />
                </div>
            </div>
            <div class="form-group">
                <label>Secondary Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.SecondaryColor" />
                    <input @bind="_edit.SecondaryColor" />
                </div>
            </div>
            <div class="form-group">
                <label>Accent Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.AccentColor" />
                    <input @bind="_edit.AccentColor" />
                </div>
            </div>
            <div class="form-group">
                <label>Background Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.BackgroundColor" />
                    <input @bind="_edit.BackgroundColor" />
                </div>
            </div>
            <div class="form-group">
                <label>Surface Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.SurfaceColor" />
                    <input @bind="_edit.SurfaceColor" />
                </div>
            </div>
            <div class="form-group">
                <label>Text Color</label>
                <div class="color-input-row">
                    <input type="color" @bind="_edit.TextColor" />
                    <input @bind="_edit.TextColor" />
                </div>
            </div>
        </div>

        <div class="form-row" style="margin-top:0.5rem">
            <div class="form-group">
                <label>Body Font</label>
                <select @bind="_edit.FontFamily">
                    <option value="Inter">Inter</option>
                    <option value="Roboto">Roboto</option>
                    <option value="Poppins">Poppins</option>
                    <option value="Fira Code">Fira Code</option>
                    <option value="JetBrains Mono">JetBrains Mono</option>
                    <option value="Georgia">Georgia (serif)</option>
                </select>
            </div>
            <div class="form-group">
                <label>Heading Font</label>
                <select @bind="_edit.HeadingFontFamily">
                    <option value="Inter">Inter</option>
                    <option value="Roboto">Roboto</option>
                    <option value="Poppins">Poppins</option>
                    <option value="Playfair Display">Playfair Display</option>
                    <option value="Georgia">Georgia (serif)</option>
                </select>
            </div>
        </div>

        <!-- Presets -->
        <div style="margin:1rem 0">
            <p style="font-size:0.8rem; font-weight:600; color:var(--admin-muted); text-transform:uppercase; letter-spacing:0.04em; margin-bottom:0.5rem">Quick Presets</p>
            <div style="display:flex; gap:0.5rem; flex-wrap:wrap">
                <button class="btn-sm" @onclick='() => ApplyPreset("#6366f1","#8b5cf6","#06b6d4","#0f172a","#1e293b","#f8fafc")'>Midnight Indigo</button>
                <button class="btn-sm" @onclick='() => ApplyPreset("#10b981","#059669","#f59e0b","#0f2028","#172a34","#f0fdf4")'>Forest Green</button>
                <button class="btn-sm" @onclick='() => ApplyPreset("#f97316","#ef4444","#facc15","#1a0a00","#2a1500","#fff7ed")'>Sunset Fire</button>
                <button class="btn-sm" @onclick='() => ApplyPreset("#3b82f6","#60a5fa","#e879f9","#0a0a1a","#12122a","#eff6ff")'>Deep Space</button>
                <button class="btn-sm" @onclick='() => ApplyPreset("#6366f1","#8b5cf6","#06b6d4","#ffffff","#f8fafc","#111827")'>Light Mode</button>
            </div>
        </div>

        <div class="editor-actions">
            <button class="btn-primary" @onclick="SaveAsync" disabled="@_saving">
                @(_saving ? "Saving..." : "Save Theme")
            </button>
            @if (!string.IsNullOrEmpty(_message))
            {
                <span class="save-message">@_message</span>
            }
        </div>
    }
    else
    {
        <p style="color:var(--admin-muted)">Loading theme…</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public ThemeDto? Theme { get; set; }
    [Parameter, EditorRequired] public EventCallback OnSave { get; set; }
    [Parameter, EditorRequired] public PortfolioApiService Api { get; set; } = null!;

    private EditThemeModel? _edit;
    private bool _saving;
    private string? _message;

    protected override void OnParametersSet()
    {
        if (Theme is not null && _edit is null)
            _edit = new EditThemeModel(Theme);
    }

    private void ApplyPreset(string primary, string secondary, string accent,
        string bg, string surface, string text)
    {
        if (_edit is null) return;
        _edit.PrimaryColor = primary;
        _edit.SecondaryColor = secondary;
        _edit.AccentColor = accent;
        _edit.BackgroundColor = bg;
        _edit.SurfaceColor = surface;
        _edit.TextColor = text;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_edit is null) return;
        _saving = true; _message = null;
        try
        {
            await Api.UpdateThemeAsync(new
            {
                primaryColor = _edit.PrimaryColor,
                secondaryColor = _edit.SecondaryColor,
                accentColor = _edit.AccentColor,
                backgroundColor = _edit.BackgroundColor,
                surfaceColor = _edit.SurfaceColor,
                textColor = _edit.TextColor,
                fontFamily = _edit.FontFamily,
                headingFontFamily = _edit.HeadingFontFamily
            });
            _message = "✅ Theme saved! Refresh the public site to see changes.";
            await OnSave.InvokeAsync();
        }
        catch (Exception ex) { _message = $"❌ {ex.Message}"; }
        finally { _saving = false; }
    }

    private class EditThemeModel
    {
        public string PrimaryColor { get; set; }
        public string SecondaryColor { get; set; }
        public string AccentColor { get; set; }
        public string BackgroundColor { get; set; }
        public string SurfaceColor { get; set; }
        public string TextColor { get; set; }
        public string FontFamily { get; set; }
        public string HeadingFontFamily { get; set; }

        public EditThemeModel(ThemeDto t)
        {
            PrimaryColor = t.PrimaryColor; SecondaryColor = t.SecondaryColor;
            AccentColor = t.AccentColor; BackgroundColor = t.BackgroundColor;
            SurfaceColor = t.SurfaceColor; TextColor = t.TextColor;
            FontFamily = t.FontFamily; HeadingFontFamily = t.HeadingFontFamily;
        }
    }
}
