@page "/admin/login"
@inject PortfolioApiService Api
@inject NavigationManager Nav

<PageTitle>Admin Login</PageTitle>

<div class="login-page">
    <div class="login-card">
        <h1>Admin Access</h1>
        <p class="login-hint">This page is not linked publicly.</p>

        <div class="form-group">
            <label>Username</label>
            <input type="text" @bind="_username" @onkeydown="HandleKeyDown" placeholder="admin" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" @bind="_password" @onkeydown="HandleKeyDown" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="login-error">@_error</p>
        }

        <button class="btn-primary" @onclick="LoginAsync" disabled="@_loading"
                style="width:100%; margin-top:1rem">
            @(_loading ? "Signing in..." : "Sign In")
        </button>
    </div>
</div>

@code {
    private string _username = "";
    private string _password = "";
    private string _error = "";
    private bool _loading = false;

    protected override void OnInitialized()
    {
        if (Api.Auth.IsAdmin)
            Nav.NavigateTo("/admin");
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginAsync();
    }

    private async Task LoginAsync()
    {
        _error = "";
        _loading = true;

        var success = await Api.LoginAsync(_username, _password);

        if (success && Api.Auth.IsAdmin)
            Nav.NavigateTo("/admin");
        else
            _error = "Invalid credentials or insufficient permissions.";

        _loading = false;
    }
}
