@page "/"
@page "/p/{Username}"
@using PortfolioCMS.Web.Components.Public
@inject PortfolioApiService Api
@inject PortfolioHubService Hub
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.JSInterop

<PageTitle>@(_hero?.Title ?? "Portfolio")</PageTitle>

@if (_loading)
{
    <div class="loading-screen">
        <div class="loader"></div>
    </div>
}
else if (_notFound)
{
    <div class="loading-screen" style="flex-direction:column; gap:1rem">
        <h1 style="margin:0">Portfolio not found</h1>
        <p style="opacity:.7">No portfolio exists at <strong>/p/@Username</strong>.</p>
        <a class="btn-primary" href="/register">Create your own</a>
    </div>
}
else
{
    @if (_theme is not null)
    {
        <style>
            :root {
                --color-primary: @_theme.PrimaryColor;
                --color-secondary: @_theme.SecondaryColor;
                --color-accent: @_theme.AccentColor;
                --color-bg: @_theme.BackgroundColor;
                --color-surface: @_theme.SurfaceColor;
                --color-text: @_theme.TextColor;
                --font-body: '@_theme.FontFamily', sans-serif;
                --font-heading: '@_theme.HeadingFontFamily', sans-serif;
            }
        </style>
    }

    <div class="portfolio" style="background:var(--color-bg); color:var(--color-text); font-family:var(--font-body)">

        <nav class="navbar">
            @* Splitting on "," turned the default "Hi, I'm bob" into just "Hi". *@
            <span class="nav-logo">@(_hero?.Title?.Trim() is { Length: > 0 } t ? t : "Portfolio")</span>

            <div class="nav-links">
                @foreach (var sec in _sections.Where(s => s.IsVisible))
                {
                    <a href="@PagePath#@(sec.Type.ToLower())">@sec.Type</a>
                }
            </div>
        </nav>

        @foreach (var sec in _sections.Where(s => s.IsVisible).OrderBy(s => s.DisplayOrder))
        {
            <section id="@(sec.Type.ToLower())"
                     class="@(sec.Type == "Hero" ? "hero-stage" : null)"
                     data-reveal
                     style="background:@(sec.BackgroundColor); color:@(sec.TextColor)">

                @switch (sec.Type)
                {
                    case "Hero":
                        @* Backdrop for the three.js scene. Stays empty and
                           invisible if WebGL or the CDN is unavailable. *@
                        <canvas class="fx-canvas" data-fx-hero aria-hidden="true"></canvas>
                        <HeroSection Section="sec" PagePath="@PagePath" />
                        break;

                    case "About":
                        <AboutSection Section="sec" />
                        break;

                    case "Skills":
                        <SkillsSection Section="sec" />
                        break;

                    case "Projects":
                        <ProjectsSection Projects="_projects" Section="sec" />
                        break;

                    case "Contact":
                        <ContactSection Section="sec" />
                        break;
                }

            </section>
        }

    </div>
}

@code {
    private List<SectionDto> _sections = [];
    private List<ProjectDto> _projects = [];
    private ThemeDto? _theme;
    private SectionDto? _hero;
    private bool _loading = true;

    /// <summary>Username from /p/{Username}. Null on "/", which renders the
    /// site owner's portfolio.</summary>
    [Parameter] public string? Username { get; set; }

    private bool _notFound;

    /// <summary>Absolute path of the page currently being rendered. In-page
    /// anchors must be prefixed with it: &lt;base href="/"&gt; makes a bare
    /// "#skills" resolve to "/#skills", which navigates away to the site
    /// owner's portfolio instead of scrolling down this one.</summary>
    private string PagePath =>
        string.IsNullOrWhiteSpace(Username) ? "/" : $"/p/{Username}";

    // Which username the loaded content belongs to, so anchor navigation
    // (same route, different fragment) does not refetch and flash the loader.
    private string? _loadedFor;

    // OnParametersSetAsync rather than OnInitializedAsync: navigating from
    // /p/alice to /p/bob reuses this component instance, and initialisation
    // would not run a second time.
    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();

        if (!_hubStarted)
        {
            Hub.OnContentUpdated += HandleContentUpdated;
            Hub.OnThemeUpdated += HandleThemeUpdated;

            var apiBase = Config["ApiBaseUrl"] ?? "http://localhost:5000";
            await Hub.StartAsync(apiBase);

            _hubStarted = true;
        }
    }

    private bool _hubStarted;

    private async Task LoadAsync()
    {
        var key = Username ?? "";

        // Same portfolio as last render — only the fragment changed.
        if (_loadedFor == key) return;

        _loading = true;
        _notFound = false;

        var portfolio = await Api.GetPublicPortfolioAsync(Username);
        _loadedFor = key;

        if (portfolio is null)
        {
            _notFound = true;
            _loading = false;
            return;
        }

        _sections = portfolio.Sections;
        _projects = portfolio.Projects;
        _theme = portfolio.Theme;
        _hero = _sections.FirstOrDefault(s => s.Type == "Hero");

        _loading = false;
    }

    private void HandleContentUpdated(string sectionType, object? _)
    {
        InvokeAsync(async () =>
        {
            var portfolio = await Api.GetPublicPortfolioAsync(Username);

            if (portfolio is not null)
            {
                _sections = portfolio.Sections;
                _projects = portfolio.Projects;
                _hero = _sections.FirstOrDefault(s => s.Type == "Hero");
            }

            StateHasChanged();
        });
    }

    private void HandleThemeUpdated(ThemeDto? newTheme)
    {
        InvokeAsync(() =>
        {
            _theme = newTheme;
            StateHasChanged();
        });
    }

    // ── Visual effects ────────────────────────────────────────────────────
    // Driven from JS because they need the real DOM: WebGL, IntersectionObserver
    // and pointer geometry have no Blazor equivalent.

    private bool _fxStarted;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _notFound) return;

        try
        {
            if (!_fxStarted)
            {
                await JS.InvokeVoidAsync("portfolioFx.init", new
                {
                    primary   = _theme?.PrimaryColor,
                    secondary = _theme?.SecondaryColor,
                    accent    = _theme?.AccentColor
                });

                _fxStarted = true;
            }
            else
            {
                // Content changed underneath us (live update, or a different
                // user's page) — rebind observers to the new nodes.
                await JS.InvokeVoidAsync("portfolioFx.refresh");
            }
        }
        catch (JSException)
        {
            // The effects module is optional; a failure here must not take
            // the page down with it.
        }
    }

    public async ValueTask DisposeAsync()
    {
        Hub.OnContentUpdated -= HandleContentUpdated;
        Hub.OnThemeUpdated -= HandleThemeUpdated;

        try { await JS.InvokeVoidAsync("portfolioFx.dispose"); }
        catch (JSException) { }
        catch (TaskCanceledException) { }

        await Hub.DisposeAsync();
    }
}