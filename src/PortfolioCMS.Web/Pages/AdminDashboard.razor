@page "/admin"
@inject PortfolioApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.JSInterop
@using PortfolioCMS.Web.Components.Admin
@using PortfolioCMS.Web.Components.Public

<PageTitle>Admin — Portfolio CMS</PageTitle>

@if (!Api.Auth.IsAdmin)
{
    Nav.NavigateTo("/admin/login");
    return;
}

<div class="admin-layout">

    <!-- Sidebar -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <span>⚡ Portfolio CMS</span>
            <small>@Api.Auth.Username</small>
        </div>

        <!-- The user's public link, so sharing never requires guessing the URL. -->
        <div class="sidebar-share">
            <small>Your public portfolio</small>
            <div class="share-row">
                <a href="@PublicPath" target="_blank" rel="noopener">@PublicPath</a>
                <button class="btn-copy @(_copied ? "is-copied" : "")" @onclick="CopyLinkAsync"
                        title="Copy the full link">@(_copied ? "Copied" : "Copy")</button>
            </div>
        </div>
        <nav class="sidebar-nav">
            <button class="@NavClass("sections")" @onclick='() => _tab = "sections"'>Sections</button>
            <button class="@NavClass("projects")" @onclick='() => _tab = "projects"'>Projects</button>
            <button class="@NavClass("theme")" @onclick='() => _tab = "theme"'>Theme</button>
            <button class="@NavClass("audit")" @onclick='() => _tab = "audit"'>Audit Log</button>
        </nav>
        <div class="sidebar-footer">
            <!-- Must be the signed-in user's own portfolio. "/" is the site
                 owner's page, which for everyone else is somebody else's. -->
            <a href="@PublicPath" target="_blank" class="preview-link">View Live Site ↗</a>
            <button @onclick="LogoutAsync" class="btn-danger-sm">Logout</button>
        </div>
    </aside>

    <!-- Main content area -->
    <main class="admin-main">
    @if (_tab == "sections")
    {
        <SectionsEditor Sections="_sections" OnSave="LoadDataAsync" Api="Api" />
    }
    else if (_tab == "projects")
    {
        <ProjectsEditor Projects="_projects" OnSave="LoadDataAsync" Api="Api" />
    }
    else if (_tab == "theme")
    {
        <ThemeEditor Theme="_theme" OnSave="LoadDataAsync" Api="Api" />
    }
    else if (_tab == "audit")
    {
        <AuditLogViewer />
    }
</main>
</div>

@code {
    private string _tab = "sections";
    private List<SectionDto> _sections = [];
    private List<ProjectDto> _projects = [];
    private ThemeDto? _theme;

    protected override async Task OnInitializedAsync()
        => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        _sections = await Api.GetSectionsAsync() ?? [];
        _projects = await Api.GetProjectsAsync(visibleOnly: false) ?? [];
        _theme = await Api.GetThemeAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Api.LogoutAsync();
        Nav.NavigateTo("/admin/login");
    }

    private string NavClass(string tab)
        => _tab == tab ? "nav-item active" : "nav-item";

    private string PublicPath => $"/p/{Api.Auth.Username}";

    private string PublicUrl => $"{Nav.BaseUri.TrimEnd('/')}{PublicPath}";

    private bool _copied;

    // Copies the absolute URL — the sidebar shows the short path, but what
    // someone pastes into a message has to be the full link.
    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", PublicUrl);
            _copied = true;
            StateHasChanged();

            await Task.Delay(1800);
            _copied = false;
        }
        catch (JSException)
        {
            // Clipboard blocked (insecure context or denied permission) — the
            // link stays visible and selectable next to the button.
        }
    }
}
